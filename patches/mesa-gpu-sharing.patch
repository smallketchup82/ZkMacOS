+
+PUBLIC bool recoil_kk_get_metal_texture_v1(void *device_handle, uint64_t image_handle,
+                                          void **device, void **texture);
+PUBLIC void *recoil_kk_get_metal_queue_v1(void *device_handle);
+
+PUBLIC void *
+recoil_kk_get_metal_queue_v1(void *device_handle)
+{
+   if (!device_handle)
+      return NULL;
+
+   VK_FROM_HANDLE(kk_device, dev, (VkDevice)device_handle);
+   return dev->has_queue ? dev->queue.mtl_handle : NULL;
+}
+
+PUBLIC bool
+recoil_kk_get_metal_texture_v1(void *device_handle, uint64_t image_handle,
+                              void **device, void **texture)
+{
+   if (!device_handle || !image_handle || !device || !texture)
+      return false;
+
+   VK_FROM_HANDLE(kk_device, dev, (VkDevice)device_handle);
+   VK_FROM_HANDLE(kk_image, image, (VkImage)image_handle);
+   if (image->vk.base.device != &dev->vk || image->plane_count != 1 ||
+       image->vk.image_type != VK_IMAGE_TYPE_2D || image->vk.samples != 1 ||
+       image->vk.array_layers != 1 || image->vk.mip_levels != 1 ||
+       !image->planes[0].mtl_handle)
+      return false;
+
+   *device = dev->mtl_handle;
+   *texture = image->planes[0].mtl_handle;
+   return true;
+}
 
