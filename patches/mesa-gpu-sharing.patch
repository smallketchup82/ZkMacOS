+
+bool
+zink_recoil_get_vk_image(struct pipe_screen *pscreen, struct pipe_resource *resource,
+                        void **device, uint64_t *image)
+{
+   struct zink_screen *screen = zink_screen(pscreen);
+   struct zink_resource *res = zink_resource(resource);
+   if (zink_driverid(screen) != VK_DRIVER_ID_MESA_KOSMICKRISP ||
+       !res->obj || res->obj->is_buffer || res->swapchain || res->transient ||
+       resource->target != PIPE_TEXTURE_2D || resource->nr_samples > 1 ||
+       resource->last_level != 0 || resource->array_size != 1)
+      return false;
+
+   *device = (void *)screen->dev;
+   *image = (uint64_t)res->obj->image;
+   return true;
+}
