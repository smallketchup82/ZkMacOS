+PUBLIC bool recoil_mesa_get_vk_color_buffer_v1(void **device, uint64_t *image);
+PUBLIC bool recoil_mesa_flush_gpu_v1(void);
+
+PUBLIC bool
+recoil_mesa_flush_gpu_v1(void)
+{
+   struct gl_context *ctx = _mesa_get_current_context();
+   if (!ctx)
+      return false;
+
+   struct st_context *st = st_context(ctx);
+   if (strncmp(st->screen->get_name(st->screen), "zink ", 5))
+      return false;
+
+   _mesa_glthread_finish(ctx);
+   /* Submit Gallium's threaded work and Zink's batch before the caller signals
+    * the native queue. Flags 0 waits for CPU submission, never GPU completion. */
+   st->pipe->flush(st->pipe, NULL, 0);
+   return true;
+}
+
+PUBLIC bool
+recoil_mesa_get_vk_color_buffer_v1(void **device, uint64_t *image)
+{
+   struct gl_context *ctx = _mesa_get_current_context();
+   if (!ctx || !device || !image)
+      return false;
+
+   struct st_context *st = st_context(ctx);
+   if (strncmp(st->screen->get_name(st->screen), "zink ", 5))
+      return false;
+
+   _mesa_glthread_finish(ctx);
+   _mesa_update_state(ctx);
+   struct gl_renderbuffer *buffer = ctx->ReadBuffer->_ColorReadBuffer;
+   if (!buffer || !buffer->texture || buffer->NumSamples > 1)
+      return false;
+
+   return zink_recoil_get_vk_image(st->screen, buffer->texture, device, image);
+}
+#endif
